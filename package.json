{
  "name": "web-ym2151",
  "version": "1.0.0",
  "description": "Browser-based YM2151 sound chip emulator and tone editor",
  "exports": {
    "./random-tone": {
      "import": "./dist/random-tone/index.js",
      "types": "./dist/random-tone/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && node fix-imports.js && tsc -p demo-library/tsconfig.json",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "keywords": [
    "ym2151",
    "opm",
    "sound",
    "emulator"
  ],
  "author": "",
  "license": "MIT"
}
